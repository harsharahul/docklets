# docklets gateway config. Runs INSIDE the hardened Caddy container.
#
# The container sees ONLY the asset root (mounted read-only at /srv); the host
# filesystem is absent, so a symlink or path traversal inside an asset cannot
# reach host files.
#
# The admin endpoint is bound to localhost INSIDE the container's network
# namespace (never published). It exists only so the deployer can
# `docker exec <gateway> caddy reload` for zero-downtime route updates.
{
	admin localhost:2019
	auto_https off
	persist_config off
}

http://:8080 {
	root * /srv
	encode gzip

	# The bare root redirects to the status dashboard instead of listing every
	# slug. Individual routes still resolve; there is no public file index. The
	# installers deploy the dashboard to /status/ so this target always exists.
	@root path /
	redir @root /status/ 302

	# Everything order-sensitive runs inside this one route block, in written
	# order: the path guards, the access check, the app routes, then the file
	# server.
	route {
		# Ambiguous paths (dot segments, double slashes, and their encoded
		# forms) are refused outright. {http.request.uri.path} is decoded but
		# not cleaned, so this sees what the cleaned matchers below never do.
		@noncanon expression `{http.request.uri.path}.matches("//|/\\.\\.?(/|$)")`
		respond @noncanon "Bad Request" 400

		# A slug's access policy is never served, by the file server or by an
		# app that serves its own folder.
		@policy path_regexp ^/[^/]+/(access\.json|\.access\.json\..*)$
		error @policy 404

		# Login page, password unlock, and secret-link redeem for private slugs.
		handle /.docklets/access/* {
			reverse_proxy {$DOCKLETS_ACCESS_UPSTREAM:127.0.0.1:9100}
		}

		# The access service decides every request under a top-level name: a
		# slug holding an access.json is private (docs/access.md). The name
		# comes from the CLEANED path, the same view file_server and the app
		# routes use, and the service reads the policy itself, so nothing the
		# gateway can or cannot see changes the answer. Without the service,
		# every request fails closed.
		@slugged path_regexp slug ^/([^/]+)
		route @slugged {
			request_header -X-Docklets-Access
			forward_auth {$DOCKLETS_ACCESS_UPSTREAM:127.0.0.1:9100} {
				uri /check?slug={re.slug.1}
				header_up -Upgrade
				header_up -Connection
				copy_headers X-Docklets-Access
			}
			# Private responses are never stored by a shared cache.
			@private header X-Docklets-Access private
			header @private >Cache-Control private
			request_header -X-Docklets-Access
			# A secret-link bearer token is for the gateway, never the app.
			@linkbearer header_regexp Authorization (?i)^bearer\s+dkl_
			request_header @linkbearer -Authorization
		}

		# Dynamic app routes maintained by the deployer. reverse_proxy terminates
		# matched requests, so proxied slugs never fall through to file_server.
		import /etc/caddy/routes/*.caddy

		# No `browse`: a directory without index.html 404s instead of listing files.
		file_server {
			hide .gateway .data .git AGENTS.md CLAUDE.md admin-ui.html .staging-* Caddyfile *.plist *.sh *.mjs *.log .DS_Store app.json access.json .access.json.*
		}
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
	}

	# A missing path answers with something readable instead of a blank
	# page. Drop your own 404.html in the asset root to replace it; the
	# built-in page below is the fallback. Its styling is inline on
	# purpose (a style block's braces would read as Caddy placeholders),
	# and the system colors follow the visitor's light or dark setting.
	handle_errors {
		@notfound expression {err.status_code} == 404
		handle @notfound {
			@ownpage file /404.html
			handle @ownpage {
				rewrite * /404.html
				file_server
			}
			handle {
				# respond sends no content type of its own, so the markup
				# would arrive as plain text without this.
				header Content-Type "text/html; charset=utf-8"
				respond <<HTML
					<!doctype html>
					<html lang="en">
					<meta charset="utf-8">
					<meta name="viewport" content="width=device-width, initial-scale=1">
					<meta name="color-scheme" content="light dark">
					<title>Nothing at this path</title>
					<body style="margin:0;min-height:100vh;display:grid;place-items:center;background:Canvas;color:CanvasText;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif">
					<main style="text-align:center;padding:2rem 1.5rem;max-width:30rem">
					<h1 style="font-size:1.3rem;margin:0 0 .6rem">Nothing at this path</h1>
					<p style="margin:.3rem 0;line-height:1.55;opacity:.72">This docklet is running, but it serves nothing at <code>{http.request.uri.path}</code>.</p>
					<p style="margin:.9rem 0 0;line-height:1.55;opacity:.72">Check the address, or go to <a href="/" style="color:LinkText">the start</a>.</p>
					<p style="margin:1.6rem 0 0;font-size:.82rem;opacity:.5">served by docklets</p>
					</main>
					HTML 404
			}
		}
		handle {
			respond "{err.status_code} {err.status_text}" {err.status_code}
		}
	}

	log {
		output stdout
	}
}
